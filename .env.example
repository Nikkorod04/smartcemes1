APP_NAME=SmartCEMES
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false. Debug mode leaks stack
# traces and environment values on every error page.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# PRODUCTION: the public URL, e.g. https://smartcemes.lnu.edu.ph
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: warning or error — `debug` fills the log with noise.
LOG_LEVEL=debug

# SmartCEMES runs on MySQL / MariaDB. (The test suite uses sqlite :memory: —
# that is pinned in phpunit.xml, not here, so changing this is safe.)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartcemes_v4
DB_USERNAME=root
DB_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Transient-failure retry for the Gemini calls — 503 capacity shedding under peak
# load ("temporarily restricting capacity for preview or flash models") and 429
# quota. Delays are milliseconds; retries apply ONLY to 408/429/5xx, never to a
# 4xx such as a bad key or a depleted prepay balance (402).
GEMINI_RETRY_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=1000
GEMINI_RETRY_MAX_MS=8000
GEMINI_RETRY_BUDGET_MS=120000

# ---------------------------------------------------------------------------
# Nightly database backup (php artisan smartcemes:backup-database, 02:00 daily)
# ---------------------------------------------------------------------------
# The mysqldump executable. Leave blank to use whatever is on the PATH — but a
# Windows box (XAMPP / Laragon / WAMP) or a shared host very often keeps it
# outside the PATH, in which case set the full path or the 02:00 run fails with
# "'mysqldump' is not recognized".
#   XAMPP example:    DB_DUMP_BINARY="C:/xampp/mysql/bin/mysqldump.exe"
#   Linux example:    DB_DUMP_BINARY=/usr/bin/mysqldump
DB_DUMP_BINARY=
# Destination directory. Blank = storage/app/backups.
DB_BACKUP_DIR=
# How many dumps to retain. 0 keeps every dump.
DB_BACKUP_KEEP=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploads (proposal documents, special orders, import source files) go to the
# PUBLIC disk and are served from /storage, so a deploy MUST run
# `php artisan storage:link` or every attachment 404s.
FILESYSTEM_DISK=local
# AI generation is SYNCHRONOUS (v4.4), so no queue worker is required. Add one
# only if the two AI jobs are ever flipped back to async.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
